@page "/cv-source"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using PfeCopilot.Application.Ai.Models
@using PfeCopilot.Application.Applications
@using PfeCopilot.Application.Common
@using PfeCopilot.Domain.Entities
@using PfeCopilot.Domain.Enums
@inject IAppDbContext Db
@inject ICurrentUserService CurrentUser
@inject ImportCvFromPdfHandler ImportHandler

<PageTitle>Mon CV source</PageTitle>

<h1>Mon CV source</h1>
<p class="text-muted">
    C'est la seule matière première que l'IA a le droit d'utiliser pour générer vos CV et lettres de
    motivation adaptés : elle pourra reformuler, sélectionner ou réordonner ces faits, jamais en inventer.
</p>

@if (_profile is null)
{
    <p><em>Chargement…</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">Importer depuis mon CV (PDF)</div>
        <div class="card-body">
            <p class="text-muted">
                L'IA lit votre PDF et propose des faits <strong>fidèles au texte</strong> (aucune invention) :
                relisez-les et corrigez si besoin avant de les ajouter ci-dessous.
            </p>
            <InputFile OnChange="OnPdfSelectedAsync" accept="application/pdf" disabled="@_importing" />
            @if (_importing)
            {
                <p class="text-muted mt-2"><em>Extraction en cours (analyse IA)…</em></p>
            }
            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="alert alert-danger mt-2">@_importError</div>
            }

            @if (_reviewFacts is not null)
            {
                <hr />
                <h5>Relecture avant import (@_reviewFacts.Count(f => f.Include) / @_reviewFacts.Count sélectionnés)</h5>
                @if (!string.IsNullOrWhiteSpace(_extracted?.FullName) || !string.IsNullOrWhiteSpace(_extracted?.Email))
                {
                    <p class="text-muted">
                        Coordonnées détectées : @_extracted!.FullName · @_extracted.Phone · @_extracted.Email
                        @(_profile!.FullName == string.Empty ? "(seront utilisées pour compléter votre profil, actuellement vide)" : "")
                    </p>
                }
                <table class="table table-sm align-middle">
                    <thead><tr><th></th><th>Type</th><th>Titre</th><th>Organisation</th><th>Description</th><th>Période</th><th>Tags</th></tr></thead>
                    <tbody>
                        @foreach (var review in _reviewFacts)
                        {
                            <tr>
                                <td><input type="checkbox" @bind="review.Include" /></td>
                                <td style="min-width:9rem">
                                    <select class="form-select form-select-sm" @bind="review.Type">
                                        @foreach (var type in Enum.GetValues<CvFactType>())
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="form-control form-control-sm" @bind="review.Title" /></td>
                                <td><input class="form-control form-control-sm" @bind="review.Organization" /></td>
                                <td><input class="form-control form-control-sm" @bind="review.Description" /></td>
                                <td style="min-width:11rem">
                                    <input class="form-control form-control-sm" placeholder="yyyy-MM" @bind="review.StartDate" />
                                    <input class="form-control form-control-sm mt-1" placeholder="yyyy-MM (vide = en cours)" @bind="review.EndDate" />
                                </td>
                                <td><input class="form-control form-control-sm" @bind="review.Tags" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="btn btn-success" @onclick="ConfirmImportAsync">Valider l'import</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="CancelImport">Annuler</button>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Profil candidat</div>
        <div class="card-body">
            <EditForm Model="_profile" OnValidSubmit="SaveProfileAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom complet</label>
                        <InputText class="form-control" @bind-Value="_profile.FullName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Spécialité ciblée</label>
                        <InputText class="form-control" @bind-Value="_profile.TargetedSpecialty" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <InputText class="form-control" @bind-Value="_profile.Phone" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_profile.Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">LinkedIn</label>
                        <InputText class="form-control" @bind-Value="_profile.LinkedInUrl" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Site web</label>
                        <InputText class="form-control" @bind-Value="_profile.WebsiteUrl" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fournisseur IA préféré</label>
                        <InputSelect class="form-select" @bind-Value="_profile.PreferredAiProvider">
                            @foreach (var provider in Enum.GetValues<AiProviderType>())
                            {
                                <option value="@provider">@provider</option>
                            }
                        </InputSelect>
                        <div class="form-text">
                            Utilisé si vous avez plusieurs clés API actives. Sinon, la clé active configurée
                            est utilisée automatiquement — voir <a href="/parametres/cles-api">Clés API</a>.
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Mots-clés de veille par défaut (séparés par des virgules)</label>
                        <InputText class="form-control" @bind-Value="_profile.DefaultWatchKeywords" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Enregistrer le profil</button>
            </EditForm>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Ajouter un fait de CV</div>
        <div class="card-body">
            <EditForm Model="_newFact" OnValidSubmit="AddFactAsync">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="_newFact.Type">
                            @foreach (var type in Enum.GetValues<CvFactType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Titre</label>
                        <InputText class="form-control" @bind-Value="_newFact.Title" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Organisation</label>
                        <InputText class="form-control" @bind-Value="_newFact.Organization" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description (factuelle, vérifiable)</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_newFact.Description" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Début</label>
                        <InputDate class="form-control" @bind-Value="_newFactStart" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fin (vide = en cours)</label>
                        <InputDate class="form-control" @bind-Value="_newFactEnd" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tags (séparés par des virgules)</label>
                        <InputText class="form-control" @bind-Value="_newFact.Tags" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Ajouter ce fait</button>
            </EditForm>
        </div>
    </div>

    <h2>Faits enregistrés (@_facts.Count)</h2>
    @foreach (var group in _facts.GroupBy(f => f.Type))
    {
        <h5 class="mt-3">@group.Key</h5>
        <table class="table table-sm">
            <thead><tr><th>Titre</th><th>Organisation</th><th>Période</th><th>Tags</th><th></th></tr></thead>
            <tbody>
                @foreach (var fact in group.OrderBy(f => f.DisplayOrder))
                {
                    <tr>
                        <td>@fact.Title</td>
                        <td>@fact.Organization</td>
                        <td>@fact.StartDate?.ToString("MM/yyyy") - @(fact.EndDate?.ToString("MM/yyyy") ?? "présent")</td>
                        <td>@fact.Tags</td>
                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFactAsync(fact)">Supprimer</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private const long MaxPdfSizeBytes = 10 * 1024 * 1024;

    private CandidateProfile? _profile;
    private List<CvFact> _facts = [];
    private CvFact _newFact = NewEmptyFact();
    private DateOnly? _newFactStart;
    private DateOnly? _newFactEnd;

    private bool _importing;
    private string? _importError;
    private ExtractedCvContent? _extracted;
    private List<ReviewFact>? _reviewFacts;

    private class ReviewFact
    {
        public bool Include { get; set; } = true;
        public CvFactType Type { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Organization { get; set; }
        public string? Description { get; set; }
        public string? StartDate { get; set; }
        public string? EndDate { get; set; }
        public string Tags { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var userId = CurrentUser.UserId!;

        _profile = await Db.CandidateProfiles.SingleOrDefaultAsync(p => p.UserId == userId);
        if (_profile is null)
        {
            _profile = new CandidateProfile { UserId = userId, FullName = string.Empty };
            Db.CandidateProfiles.Add(_profile);
            await Db.SaveChangesAsync();
        }

        _facts = await Db.CvFacts.Where(f => f.UserId == userId).ToListAsync();
    }

    private async Task SaveProfileAsync()
    {
        _profile!.UpdatedAtUtc = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task AddFactAsync()
    {
        _newFact.UserId = CurrentUser.UserId!;
        _newFact.StartDate = _newFactStart;
        _newFact.EndDate = _newFactEnd;
        _newFact.DisplayOrder = _facts.Count(f => f.Type == _newFact.Type);

        Db.CvFacts.Add(_newFact);
        await Db.SaveChangesAsync();

        _facts.Add(_newFact);
        _newFact = NewEmptyFact();
        _newFactStart = null;
        _newFactEnd = null;
    }

    private async Task DeleteFactAsync(CvFact fact)
    {
        Db.CvFacts.Remove(fact);
        await Db.SaveChangesAsync();
        _facts.Remove(fact);
    }

    private static CvFact NewEmptyFact() => new() { UserId = string.Empty, Type = CvFactType.Experience, Title = string.Empty };

    private async Task OnPdfSelectedAsync(InputFileChangeEventArgs e)
    {
        _importError = null;
        _extracted = null;
        _reviewFacts = null;

        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxPdfSizeBytes)
        {
            _importError = "Le fichier dépasse la taille maximale autorisée (10 Mo).";
            return;
        }

        _importing = true;
        StateHasChanged();
        try
        {
            await using var stream = file.OpenReadStream(MaxPdfSizeBytes);
            _extracted = await ImportHandler.HandleAsync(stream);

            _reviewFacts = _extracted.Facts.Select(f => new ReviewFact
            {
                Type = Enum.TryParse<CvFactType>(f.Type, ignoreCase: true, out var type) ? type : CvFactType.Experience,
                Title = f.Title,
                Organization = f.Organization,
                Description = f.Description,
                StartDate = f.StartDate,
                EndDate = f.EndDate,
                Tags = f.Tags
            }).ToList();
        }
        catch (Exception ex)
        {
            _importError = $"Échec de l'extraction : {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (_reviewFacts is null)
        {
            return;
        }

        var userId = CurrentUser.UserId!;
        var selected = _reviewFacts.Where(f => f.Include && !string.IsNullOrWhiteSpace(f.Title)).ToList();

        foreach (var review in selected)
        {
            var fact = new CvFact
            {
                UserId = userId,
                Type = review.Type,
                Title = review.Title,
                Organization = string.IsNullOrWhiteSpace(review.Organization) ? null : review.Organization,
                Description = string.IsNullOrWhiteSpace(review.Description) ? null : review.Description,
                StartDate = ParseYearMonth(review.StartDate),
                EndDate = ParseYearMonth(review.EndDate),
                Tags = review.Tags,
                DisplayOrder = _facts.Count(f => f.Type == review.Type)
            };

            Db.CvFacts.Add(fact);
            _facts.Add(fact);
        }

        // Ne complète le profil que si les champs sont encore vides : ne jamais écraser une donnée déjà saisie.
        if (_extracted is not null)
        {
            if (string.IsNullOrWhiteSpace(_profile!.FullName) && !string.IsNullOrWhiteSpace(_extracted.FullName))
                _profile.FullName = _extracted.FullName!;
            if (string.IsNullOrWhiteSpace(_profile.Phone) && !string.IsNullOrWhiteSpace(_extracted.Phone))
                _profile.Phone = _extracted.Phone;
            if (string.IsNullOrWhiteSpace(_profile.Email) && !string.IsNullOrWhiteSpace(_extracted.Email))
                _profile.Email = _extracted.Email;
            if (string.IsNullOrWhiteSpace(_profile.LinkedInUrl) && !string.IsNullOrWhiteSpace(_extracted.LinkedInUrl))
                _profile.LinkedInUrl = _extracted.LinkedInUrl;
            if (string.IsNullOrWhiteSpace(_profile.WebsiteUrl) && !string.IsNullOrWhiteSpace(_extracted.WebsiteUrl))
                _profile.WebsiteUrl = _extracted.WebsiteUrl;
            _profile.UpdatedAtUtc = DateTime.UtcNow;
        }

        await Db.SaveChangesAsync();

        CancelImport();
    }

    private void CancelImport()
    {
        _extracted = null;
        _reviewFacts = null;
        _importError = null;
    }

    private static DateOnly? ParseYearMonth(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (DateOnly.TryParseExact(value, "yyyy-MM", out var ym))
        {
            return ym;
        }

        if (int.TryParse(value, out var year) && year is > 1900 and < 2200)
        {
            return new DateOnly(year, 1, 1);
        }

        return null;
    }
}
